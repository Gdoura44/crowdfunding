<?xml version="1.0" encoding="UTF-8"?>
<xmi:XMI xmi:version="2.5"
         xmlns:xmi="http://www.omg.org/spec/XMI/20131001"
         xmlns:uml="http://www.omg.org/spec/UML/20131001">
  <uml:Model xmi:id="m_ctx_ea15" name="Contexte_systeme_informatise">
    <packagedElement xmi:type="uml:Package" xmi:id="pkg_ctx_root" name="Contexte_boite_noire">

      <!-- Système central -->
      <packagedElement xmi:type="uml:Package" xmi:id="pkg_ctx_systeme" name="Perimetre_logiciel">
        <packagedElement xmi:type="uml:Class" xmi:id="cls_systeme_ctx" name="Plateforme de financement collaboratif"/>
      </packagedElement>

      <!-- Acteurs externes -->
      <packagedElement xmi:type="uml:Package" xmi:id="pkg_ctx_acteurs" name="Acteurs_externes">

        <!-- Acteurs humains (primaires) -->
        <packagedElement xmi:type="uml:Actor" xmi:id="act_ctx_visiteur" name="Visiteur"/>
        <packagedElement xmi:type="uml:Actor" xmi:id="act_ctx_utilisateur" name="Utilisateur"/>
        <packagedElement xmi:type="uml:Actor" xmi:id="act_ctx_expert" name="Expert en finance"/>
        <packagedElement xmi:type="uml:Actor" xmi:id="act_ctx_admin" name="Administrateur"/>

        <!-- Acteurs systèmes (secondaires) -->
        <packagedElement xmi:type="uml:Actor" xmi:id="act_ctx_paiement" name="Système de paiement"/>
        <packagedElement xmi:type="uml:Actor" xmi:id="act_ctx_banque" name="Système bancaire"/>

      </packagedElement>

    </packagedElement>

  </uml:Model>
</xmi:XMI>
